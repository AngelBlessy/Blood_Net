# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (local MongoDB / MongoDB Compass by default).
# Uses a dedicated "bloodnet2" database name to avoid colliding with any other
# local project that happens to use a plain "bloodnet" database.
MONGODB_URI=mongodb://127.0.0.1:27017/bloodnet2

# JWT signing secret for session cookies - use a long random string.
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Seeded admin account (created by `npm run seed`). Change the password after first login.
ADMIN_EMAIL=admin@bloodnet.local
ADMIN_PASSWORD=your_admin_password

# SMTP (Gmail or other provider) for OTP / alert emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_NAME=Blood Donation Portal

# Optional SMS provider. Leave blank until configured.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_from_number

GOOGLE_TRANSLATE_API_KEY=your_google_cloud_api_key
