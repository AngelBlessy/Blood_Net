# Copy to .env.local for local overrides. Never commit real .env files.

# Base URL of the API server. Leave blank for local dev (Vite proxies /api
# and /socket.io to http://localhost:3000, see vite.config.ts) and for any
# deployment where the client and server share an origin. Set this to your
# Fly.io app's URL when the client is deployed separately, e.g. on Vercel:
# VITE_API_URL=https://bloodnet-api.fly.dev
VITE_API_URL=
